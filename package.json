{
    "name": "cugel-scripts",
    "version": "0.1.0",
    "description": "Opinionated TypeScript tooling: ESLint config and rules, tsconfig bases, esbuild build, vitest presets, and a CLI that runs the full static battery.",
    "keywords": [
        "eslint",
        "eslint-config",
        "typescript",
        "esbuild",
        "vitest",
        "knip",
        "madge",
        "tooling",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/cugel-scripts#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/cugel-scripts/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/cugel-scripts.git"
    },
    "license": "MIT",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "cugel-scripts": "./dist/src/cli/main.js"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./eslint": {
            "types": "./dist/src/eslint/index.d.ts",
            "import": "./dist/src/eslint/index.js"
        },
        "./build": {
            "types": "./dist/src/build/index.d.ts",
            "import": "./dist/src/build/index.js"
        },
        "./vitest": {
            "types": "./dist/src/vitest/index.d.ts",
            "import": "./dist/src/vitest/index.js"
        },
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/node.json": "./tsconfig/node.json",
        "./tsconfig/browser.json": "./tsconfig/browser.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "tsconfig",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsx src/cli/main.ts build",
        "tsc": "tsx src/cli/main.ts tsc",
        "lint": "tsx src/cli/main.ts lint",
        "lint:fix": "tsx src/cli/main.ts lint --fix",
        "imports": "tsx src/cli/main.ts imports",
        "imports:fix": "tsx src/cli/main.ts imports --fix",
        "imports:missing:add:all": "tsx src/cli/main.ts imports:missing --all",
        "fix": "tsx src/cli/main.ts fix",
        "fix:changed": "tsx src/cli/main.ts fix --changed",
        "test:static": "tsx src/cli/main.ts static",
        "test:static:changed": "tsx src/cli/main.ts static --changed",
        "test:unit": "tsx src/cli/main.ts test",
        "test:coverage": "tsx src/cli/main.ts test --coverage",
        "test": "npm run test:static && npm run test:coverage && npm run build",
        "prepack": "npm run build",
        "rules:unused": "tsx src/cli/main.ts rules:unused"
    },
    "devDependencies": {
        "@types/eslint": "^9.6.1",
        "tsx": "^4.23.15"
    },
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/compat": "^2.1.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@typescript-eslint/utils": "^8.72.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/browser": "^5.0.5",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "dpdm": "^4.3.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-n": "^18.5.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-security": "^4.2.0",
        "eslint-plugin-sort-export-all": "^2.1.0",
        "eslint-plugin-sort-keys": "^2.3.5",
        "eslint-plugin-unicorn": "^78.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "format-imports": "^4.0.8",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "knip": "^6.42.1",
        "playwright": "^1.64.1",
        "ts-morph": "^28.0.0",
        "ts-unused-exports": "^11.0.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vitest": "^5.0.5"
    }
}
